# BAI environment variables. Placeholders only: never commit real values. Never paste DISI values into any BAI file.
#
# ---------------------------------------------------------------------------------------------------------------------
# .env.local: LOCAL development (default for npm run dev / test / research:*). Local PostgreSQL 17 from `npm run db:server`.
# ---------------------------------------------------------------------------------------------------------------------
# SERVER-ONLY
BAI_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/bai

# ---------------------------------------------------------------------------------------------------------------------
# .env.hosted.local: HOSTED BAI Supabase project. Read only by the npm run hosted:* scripts (gitignored, chmod 600).
# Do not set BAI_DATABASE_URL in it: the owner URL is built from the ref and password below.
# ---------------------------------------------------------------------------------------------------------------------
# SERVER-ONLY
# BAI_SUPABASE_PROJECT_REF=<20-character BAI project ref>     # every hosted script refuses any other project
# BAI_SUPABASE_DB_PASSWORD=<database password>                # owner (postgres) role: migrations, verifiers, research CLI
# BAI_ALLOW_REMOTE_DB=1                                       # deliberate opt-in to a non-local database
# BAI_PUBLIC_DATABASE_URL=<written by npm run hosted:web-role> # web read pool, least-privilege bai_web role
#
# CLIENT-SAFE (designed to be public; used only by the Data API probe in hosted:security, never shipped to the browser)
# BAI_SUPABASE_URL=https://<ref>.supabase.co
# BAI_SUPABASE_PUBLISHABLE_KEY=<sb_publishable_...>
#
# Never used by BAI and never to be added: secret (sb_secret_...) or legacy service_role keys, or any NEXT_PUBLIC_*
# variable holding a password, secret key or database URL.
