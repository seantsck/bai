{
  "name": "bai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BAI \u2014 Baseball Acquisition Intelligence: league-wide MLB international and draft acquisition research",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:app && npm run test:db",
    "test:app": "node --import ./tests/support/register-ts.mjs --test \"tests/app/*.test.mjs\"",
    "test:db": "node --test --test-concurrency=4 \"tests/db/*.test.mjs\"",
    "db:server": "node scripts/db/dev-server.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/db/migrate.mjs",
    "db:fixtures": "node --env-file-if-exists=.env.local scripts/db/load-fixtures.mjs",
    "refresh:read-models": "node --env-file-if-exists=.env.local scripts/db/refresh-read-models.mjs",
    "db:parity": "node --env-file-if-exists=.env.local scripts/db/parity.mjs",
    "db:security": "node --env-file-if-exists=.env.local scripts/db/security.mjs",
    "scan:credentials": "node scripts/ci/credential-scan.mjs",
    "research:import": "node --env-file-if-exists=.env.local scripts/research/cli.mjs import",
    "research:validate": "node --env-file-if-exists=.env.local scripts/research/cli.mjs validate",
    "research:apply": "node --env-file-if-exists=.env.local scripts/research/cli.mjs apply",
    "research:conflicts": "node --env-file-if-exists=.env.local scripts/research/cli.mjs conflicts",
    "research:resolve": "node --env-file-if-exists=.env.local scripts/research/cli.mjs resolve",
    "research:identity": "node --env-file-if-exists=.env.local scripts/research/cli.mjs identity",
    "research:queue": "node --env-file-if-exists=.env.local scripts/research/cli.mjs queue",
    "research:coverage": "node --env-file-if-exists=.env.local scripts/research/cli.mjs coverage",
    "research:batches": "node --env-file-if-exists=.env.local scripts/research/cli.mjs batches",
    "research:orgs": "node --env-file-if-exists=.env.local scripts/research/cli.mjs orgs",
    "research:class": "node --env-file-if-exists=.env.local scripts/research/cli.mjs class",
    "research:plan": "node --env-file-if-exists=.env.local scripts/research/cli.mjs plan",
    "research:next": "node --env-file-if-exists=.env.local scripts/research/cli.mjs next",
    "research:progress": "node --env-file-if-exists=.env.local scripts/research/cli.mjs progress",
    "research:start": "node --env-file-if-exists=.env.local scripts/research/cli.mjs start",
    "research:pause": "node --env-file-if-exists=.env.local scripts/research/cli.mjs pause",
    "research:resume": "node --env-file-if-exists=.env.local scripts/research/cli.mjs resume",
    "research:complete": "node --env-file-if-exists=.env.local scripts/research/cli.mjs complete",
    "research:fail": "node --env-file-if-exists=.env.local scripts/research/cli.mjs fail",
    "research:supersede": "node --env-file-if-exists=.env.local scripts/research/cli.mjs supersede",
    "research:job": "node --env-file-if-exists=.env.local scripts/research/cli.mjs job",
    "research:block": "node --env-file-if-exists=.env.local scripts/research/cli.mjs block",
    "research:unblock": "node --env-file-if-exists=.env.local scripts/research/cli.mjs unblock",
    "research:lead": "node --env-file-if-exists=.env.local scripts/research/cli.mjs lead",
    "research:stage": "node --env-file-if-exists=.env.local scripts/research/cli.mjs stage",
    "research:certify": "node --env-file-if-exists=.env.local scripts/research/cli.mjs certify",
    "research:check": "node --env-file-if-exists=.env.local scripts/research/cli.mjs check",
    "research:revoke": "node --env-file-if-exists=.env.local scripts/research/cli.mjs revoke",
    "research:review": "node --env-file-if-exists=.env.local scripts/research/cli.mjs review",
    "research:reviewer": "node --env-file-if-exists=.env.local scripts/research/cli.mjs reviewer",
    "research:reconsider": "node --env-file-if-exists=.env.local scripts/research/cli.mjs reconsider",
    "research:accept": "node --env-file-if-exists=.env.local scripts/research/cli.mjs accept",
    "research:ratify": "node --env-file-if-exists=.env.local scripts/research/cli.mjs ratify",
    "research:gate": "node --env-file-if-exists=.env.local scripts/research/cli.mjs gate",
    "research:history": "node --env-file-if-exists=.env.local scripts/research/cli.mjs history",
    "research:propose": "node --env-file-if-exists=.env.local scripts/research/cli.mjs propose",
    "research:proposals": "node --env-file-if-exists=.env.local scripts/research/cli.mjs proposals",
    "research:wave": "node --env-file-if-exists=.env.local scripts/research/cli.mjs wave",
    "research:verify-pilot": "node --env-file-if-exists=.env.local scripts/research/pilot-verify.mjs --compare research/baselines/pilot-2015-lad.local.json",
    "hosted:supabase": "node --env-file=.env.hosted.local scripts/db/supabase-hosted.mjs",
    "hosted:migrate": "node --env-file=.env.hosted.local scripts/db/migrate.mjs",
    "hosted:rehearse": "node --env-file=.env.hosted.local scripts/db/rehearse-pending.mjs",
    "hosted:parity": "node --env-file=.env.hosted.local scripts/db/parity.mjs",
    "hosted:security": "node --env-file=.env.hosted.local scripts/db/security.mjs",
    "hosted:verify": "BAI_VERIFY_TARGET=hosted node --env-file=.env.hosted.local --test tests/db/hosted-readonly.test.mjs",
    "hosted:web-role": "node --env-file=.env.hosted.local scripts/db/set-web-password.mjs",
    "hosted:refresh": "node --env-file=.env.hosted.local scripts/db/refresh-read-models.mjs",
    "hosted:research": "node --env-file=.env.hosted.local scripts/research/cli.mjs",
    "hosted:verify-pilot": "node --env-file=.env.hosted.local scripts/research/pilot-verify.mjs --compare research/baselines/pilot-2015-lad.local.json",
    "hosted:start": "node --env-file=.env.hosted.local scripts/db/web-preflight.mjs && node --env-file=.env.hosted.local node_modules/next/dist/bin/next start -H 127.0.0.1",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && git diff --check && npm run scan:credentials"
  },
  "dependencies": {
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "embedded-postgres": "17.9.0-beta.17",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "supabase": "2.121.0",
    "typescript": "6.0.3"
  }
}
